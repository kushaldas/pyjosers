"""Private native protocol; public callers should use the Python modules."""

class JoseError(ValueError):
    category: str
    authentication_failure: bool
class InvalidJWKValue(JoseError): ...
class InvalidJWSObject(JoseError): ...
class InvalidJWSSignature(JoseError): ...
class InvalidJWEData(JoseError): ...
class JWTExpired(JoseError): ...
class JWTNotYetValid(JoseError): ...
class JWTInvalidClaimValue(JoseError): ...
class UnsupportedAlgorithm(JoseError): ...
POST_QUANTUM: bool
PKCS11: bool
LEGACY: bool
MAX_TOKEN_BYTES: int

def key_normalize(s: str, validate: bool) -> str: ...
def key_generate(kty: str, size: int, crv: str, alg: str) -> str: ...
def key_public(s: str) -> str: ...
def key_thumbprint(s: str, hash_name: str = "sha256") -> str: ...
def key_import(data: bytes, private: bool) -> str: ...
def key_export(s: str, private: bool) -> bytes: ...
def sign(s: str, payload: bytes, protected: str, unprotected: str | None,
         detached: bool, understood: list[str], allow_key_reference_headers: bool = False) -> str: ...
def verify(s: str, token: str, detached: bytes | None, understood: list[str]) -> bytes: ...
def encrypt(s: str, payload: bytes, protected: str, allow_key_reference_headers: bool = False) -> str: ...
def decrypt(s: str, token: str, alg: str, max_plaintext: int | None = None) -> bytes: ...
def validate_claims(claims: str, header: str, options: str, now: str | None = None) -> None: ...
def certificate(action: str, header: str, der: bytes) -> str: ...

class Pkcs11Provider:
    def __init__(self, path: str) -> None: ...
    @staticmethod
    def with_token(path: str, label: str, serial: str | None = None) -> Pkcs11Provider: ...
    @staticmethod
    def with_slot_id(path: str, slot_id: int) -> Pkcs11Provider: ...
    @property
    def slot_id(self) -> int: ...
    def open_session(self, pin: str) -> Pkcs11Session: ...

class Pkcs11Session: ...

class Pkcs11Signer:
    def __init__(self, session: Pkcs11Session, label: str, alg: str) -> None: ...
    def _sign(self, payload: bytes, protected: str, unprotected: str | None,
              detached: bool, understood: list[str], allow_key_reference_headers: bool = False) -> str: ...

class Pkcs11Verifier:
    def __init__(self, session: Pkcs11Session, label: str, alg: str) -> None: ...
    def _verify(self, token: str, detached: bytes | None, understood: list[str]) -> bytes: ...

# jose-rs 0.10 integration.
def capability_report() -> str: ...
def key_read(data: bytes, format: str, password: bytes | None = None, max_iterations: int = 10_000_000) -> str: ...
def key_write(s: str, private: bool, pem: bool, password: bytes | None = None,
              scheme: str = "aes256-cbc", iterations: int = 600_000) -> bytes: ...
def thumbprint_uri(s: str, hash_name: str) -> str: ...
def thumbprint_uri_parse(uri: str, s: str | None = None) -> str: ...
def derive_key(own: str, peer: str, algorithm_id: str, length: int,
               apu: bytes | None = None, apv: bytes | None = None) -> bytes: ...
def keyset_read(s: str, max_bytes: int, max_entries: int, strict: bool) -> str: ...
def keyset_diagnostics(s: str) -> str: ...
def claims_check(s: str) -> None: ...
def verify_batch(keys: list[str], token: str, detached: bytes | None,
                 understood: list[str], candidates: list[list[int]], all: bool) -> tuple[bytes | None, str]: ...
def jwe_encrypt(keys: list[str], password: bytes | None, payload: bytes, protected: str,
                options: str, aad: bytes | None = None, general: bool = False) -> JweEnvelope: ...

class JweEnvelope:
    def __init__(self, token: str) -> None: ...
    def serialize(self, compact: bool) -> str: ...
    def metadata(self, recipient: int | None = None) -> str: ...
    @property
    def recipient_count(self) -> int: ...
    def decrypt(self, keys: list[str], password: bytes | None, options: str,
                expected_aad: bytes | None = None, recipient: int | None = None) -> tuple[bytes, str]: ...
